    "scale": {
      "xs": "14px",
      "sm": "16px",
      "base": "18px",
      "lg": "21px",
      "xl": "25px",
      "2xl": "30px",
      "3xl": "38px",
      "4xl": "48px",
      "5xl": "56px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "line-height": {
      "latin-body": 1.6,
      "latin-heading": 1.15,
      "arabic-body": 1.8,
      "arabic-heading": 1.5
    },
    "tracking": {
      "latin-heading": "-0.01em",
      "label": "0.05em",
      "arabic": "0"
